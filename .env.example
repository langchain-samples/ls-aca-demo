# Copy to `.env` and fill in your own resources. No credential belongs in here:
# Azure auth is DefaultAzureCredential (`az login` is enough), and the model key
# is read from your shell environment, not from this file.

# --- Part 1: Dynamic Sessions ---------------------------------------------
# A Python-typed session pool, for SessionsPythonREPLTool.
AZURE_DYNAMIC_SESSIONS_POOL_MANAGEMENT_ENDPOINT=https://<region>.dynamicsessions.io/subscriptions/<subscription-id>/resourceGroups/<resource-group>/sessionPools/<python-pool>

# A Shell-typed session pool, for SessionsBashTool and SessionsBashBackend.
# A Python-typed pool will not work for these.
AZURE_DYNAMIC_SESSIONS_SHELL_POOL_MANAGEMENT_ENDPOINT=https://<region>.dynamicsessions.io/subscriptions/<subscription-id>/resourceGroups/<resource-group>/sessionPools/<shell-pool>

# --- Part 2: Sandboxes ------------------------------------------------------
# All four are required together. The notebook creates and deletes one sandbox
# in this group.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_CONTAINER_APPS_RESOURCE_GROUP=<resource-group>
AZURE_CONTAINER_APPS_SANDBOX_GROUP=<sandbox-group>
AZURE_CONTAINER_APPS_REGION=<region>

# --- Model ------------------------------------------------------------------
# NOT set here. Export these in your shell before launching Jupyter:
#   OPENAI_API_KEY   your key
#   OPENAI_BASE_URL  optional; set it to route through a gateway
